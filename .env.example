# TEMPLATE ONLY — this file IS committed to git. Never put real values here.
# Copy it to .env (which is gitignored) and fill that in instead.

# ---------------------------------------------------------------------------
# API SERVER (set these on your Node host: Render / Railway / Fly)
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# MongoDB Atlas connection string.
# Atlas > Database > Connect > Drivers. Replace <password> with the real one and
# URL-encode any special characters in it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=octal_portfolio

# Comma-separated list of sites allowed to call this API. No trailing slash.
# Without this, the browser blocks every request from your cPanel site.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Sign-in tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email delivery
#
# Railway blocks outbound SMTP on every port, so nodemailer cannot connect at
# all in production — anything that works there has to go over HTTPS on 443.
# lib/mailer.js picks its backend by which of these is set, in this order:
#   1. MAIL_RELAY_URL   2. SENDGRID_API_KEY   3. SMTP_*
#
# PRODUCTION (Railway): the cPanel mail relay. Railway renders the email and
# POSTs it to a small PHP endpoint on the cPanel host, which does the SMTP
# locally. Setup instructions in php/README.md. Mail then leaves from the host
# that is authoritative for the domain, so SPF/DKIM align.
MAIL_RELAY_URL=https://yourdomain.com/_mail/mail-relay.php
# Must match 'secret' in ~/mail-relay-config.php on the cPanel host.
#   openssl rand -hex 32
MAIL_RELAY_SECRET=

# ALTERNATIVE to the relay: SendGrid's HTTP API. Only used when MAIL_RELAY_URL
# is blank.
SENDGRID_API_KEY=
# The address mail is sent AS. With the relay it must be listed in that file's
# 'allowed_from'; with SendGrid it must be a verified sender.
MAIL_FROM=

# LOCAL DEVELOPMENT: leave MAIL_RELAY_URL and SENDGRID_API_KEY blank and these
# are used instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
CC_EMAIL=

# ---------------------------------------------------------------------------
# FIRST ADMIN ACCOUNT — read once by `npm run db:seed`, then safe to remove.
# Every later account is created from inside the admin panel.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# FRONTEND BUILD (used by `npm run build`, baked into dist/)
# ---------------------------------------------------------------------------
# Where the API lives. Leave BLANK for local development so the Vite proxy
# handles /api. Set it before building the bundle you upload to cPanel.
VITE_API_BASE_URL=
