# TEMPLATE ONLY — this file IS committed to git. Never put real values here.
# Copy it to .env (which is gitignored) and fill that in instead.

# ---------------------------------------------------------------------------
# API SERVER (set these on your Node host: Render / Railway / Fly)
# ---------------------------------------------------------------------------
NODE_ENV=production
PORT=3001
HOST=0.0.0.0

# MongoDB Atlas connection string.
# Atlas > Database > Connect > Drivers. Replace <password> with the real one and
# URL-encode any special characters in it.
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/?retryWrites=true&w=majority
MONGODB_DB=octal_portfolio

# Comma-separated list of sites allowed to call this API. No trailing slash.
# Without this, the browser blocks every request from your cPanel site.
ALLOWED_ORIGINS=https://yourdomain.com,https://www.yourdomain.com

# Sign-in tokens. Use a long random string, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# Email delivery
#
# PRODUCTION (Railway): use SendGrid. Railway blocks outbound SMTP on every
# port, so nodemailer cannot connect at all — the HTTP API goes over 443.
# Set SENDGRID_API_KEY and the SMTP_* values below are ignored.
SENDGRID_API_KEY=
# Must be a sender verified in SendGrid (Settings > Sender Authentication).
MAIL_FROM=

# LOCAL DEVELOPMENT: leave SENDGRID_API_KEY blank and these are used instead.
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
ADMIN_EMAIL=
CC_EMAIL=

# ---------------------------------------------------------------------------
# FIRST ADMIN ACCOUNT — read once by `npm run db:seed`, then safe to remove.
# Every later account is created from inside the admin panel.
# ---------------------------------------------------------------------------
SEED_ADMIN_EMAIL=
SEED_ADMIN_PASSWORD=
SEED_ADMIN_NAME=Administrator

# ---------------------------------------------------------------------------
# FRONTEND BUILD (used by `npm run build`, baked into dist/)
# ---------------------------------------------------------------------------
# Where the API lives. Leave BLANK for local development so the Vite proxy
# handles /api. Set it before building the bundle you upload to cPanel.
VITE_API_BASE_URL=
