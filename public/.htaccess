# Copied into dist/ by the Vite build, so it ships with the files you upload
# to cPanel's public_html.
#
# React Router owns the URLs. Without this, loading /careers or /admin directly
# (or refreshing on them) asks Apache for a folder that does not exist and
# returns 404.

<IfModule mod_rewrite.c>
  RewriteEngine On

  # Serve real files and directories as-is.
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # Everything else is handled by the SPA.
  RewriteRule ^ index.html [L]
</IfModule>

# Hashed asset filenames change on every build, so they can be cached hard.
<IfModule mod_headers.c>
  <FilesMatch "\.(js|css|woff2|png|jpe?g|svg|webp)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>

  # index.html must never be cached, or visitors keep loading a stale bundle
  # that points at deleted asset files.
  <FilesMatch "^index\.html$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>
